{
    "name": "pinkary/nativephp-camera-picker",
    "description": "Implements NativePHP's Camera.PickMedia bridge function for the Pinkary composer.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.2"
    },
    "autoload": {
        "psr-4": {
            "Pinkary\\NativePhp\\CameraPicker\\": "src/"
        }
    },
    "extra": {
        "nativephp": {
            "manifest": "nativephp.json"
        },
        "laravel": {
            "providers": [
                "Pinkary\\NativePhp\\CameraPicker\\CameraPickerServiceProvider"
            ]
        }
    }
}
